# Server Configuration
PORT=3000

# Administrative API Access Key (Set a strong secret key in production)
ADMIN_API_KEY=your_secure_admin_api_key_here

# Allowed CORS Origins (comma-separated, leave blank to allow same-origin)
ALLOWED_ORIGINS=https://vstarnumerology.com

# Email Automation Settings (Nodemailer)
# Set to true to automatically send confirmation emails upon appointment submission
ENABLE_AUTO_MAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM="V STAR Numerology" <your_email@gmail.com>

# Security & Encryption (AES-256)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
BACKUP_PASSPHRASE=your_secure_backup_passphrase_here
